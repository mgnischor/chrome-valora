    "name": "valora-business-calculator",
    "version": "1.0.2",
    "private": true,
    "description": "Chrome extension with business calculators: ROI, liquidity, break-even, NPV/IRR and more.",
    "type": "module",
    "scripts": {
        "build": "node scripts/build.mjs",
        "watch": "node scripts/build.mjs --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "icons": "node scripts/make-icons.mjs",
        "package": "node scripts/package.mjs",
        "check": "npm run typecheck && npm test && npm run build"
    },
    "devDependencies": {
        "@types/chrome": "^0.0.326",
        "@types/node": "^22.20.5",
        "esbuild": "^0.28.2",
        "typescript": "^5.8.0",
        "vitest": "^5.0.5"
    }
}
